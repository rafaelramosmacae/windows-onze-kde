[Icon Theme]
Name=Onze Dark
Comment=Original Fluent-style icons for the Onze theme (Windows 11 inspired) — dark variant
Inherits=breeze-dark,hicolor
Example=folder
DisplayDepth=32
FollowsColorScheme=true
LinkOverlay=link
LockOverlay=lockoverlay
ZipOverlay=zip
DesktopDefault=48
ToolbarDefault=22
MainToolbarDefault=22
SmallDefault=16
PanelDefault=48

